{
  "manifest_version": 3,
  "name": "EMBASIC DeepSeek Agent - Proje ve Görev Merkezi",
  "short_name": "EMBASIC Agent",
  "version": "1.12.0",
  "description": "DeepSeek Free için kontrollü proje, saatlik görev, GitHub ve Google Drive arşiv yöneticisi. Web sohbetini otomatik çalıştırmaz.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "identity",
    "notifications",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_CHROME_EXTENSION_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "action": {
    "default_title": "EMBASIC DeepSeek Agent",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "dashboard.html",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
